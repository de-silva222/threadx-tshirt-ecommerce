{
    "name": "threadx/backend",
    "description": "THREADX T-shirt e-commerce REST API (CodeIgniter 4)",
    "type": "project",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.5"
    },
    "require-dev": {
        "codeigniter4/devkit": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
