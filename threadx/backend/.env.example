#--------------------------------------------------------------------
# THREADX BACKEND — ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = threadx_store
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port     = 3306

#--------------------------------------------------------------------
# AUTH / JWT
#--------------------------------------------------------------------
# Generate a long random string, e.g. `php -r "echo bin2hex(random_bytes(32));"`
AUTH_JWT_SECRET = replace_with_a_long_random_secret_string
AUTH_TOKEN_TTL_MINUTES = 10080

#--------------------------------------------------------------------
# CORS — frontend origin allowed to call this API
#--------------------------------------------------------------------
CORS_ALLOWED_ORIGIN = http://localhost:5173

#--------------------------------------------------------------------
# IMAGE STORAGE
# STORAGE_DRIVER = local | cloudinary
#--------------------------------------------------------------------
STORAGE_DRIVER = local
STORAGE_LOCAL_PATH = public/uploads
STORAGE_LOCAL_URL  = http://localhost:8080/uploads

CLOUDINARY_CLOUD_NAME =
CLOUDINARY_API_KEY =
CLOUDINARY_API_SECRET =

#--------------------------------------------------------------------
# PAYMENT GATEWAY (PayHere — Sri Lanka)
# Fill these in manually. NEVER commit real secrets.
# Sandbox docs: https://support.payhere.lk/api-&-mobile-sdk/payhere-checkout
#--------------------------------------------------------------------
PAYMENT_PROVIDER = payhere
PAYMENT_MODE = sandbox
PAYHERE_MERCHANT_ID =
PAYHERE_MERCHANT_SECRET =
PAYHERE_NOTIFY_URL = http://localhost:8080/api/payments/callback
PAYHERE_RETURN_URL = http://localhost:5173/order-confirmation
PAYHERE_CANCEL_URL = http://localhost:5173/checkout

#--------------------------------------------------------------------
# MAIL (for order confirmations, password resets)
#--------------------------------------------------------------------
MAIL_HOST =
MAIL_PORT = 587
MAIL_USERNAME =
MAIL_PASSWORD =
MAIL_FROM_ADDRESS = orders@threadx.example
MAIL_FROM_NAME = "THREADX"

#--------------------------------------------------------------------
# WHATSAPP NOTIFICATIONS (optional, e.g. via WhatsApp Business API / Twilio)
#--------------------------------------------------------------------
WHATSAPP_API_URL =
WHATSAPP_API_TOKEN =
WHATSAPP_STORE_NUMBER =
